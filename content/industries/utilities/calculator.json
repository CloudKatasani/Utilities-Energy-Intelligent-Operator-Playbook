{
  "_note": "Spec §10 and C2: every formula is a named expression evaluated by src/js/core/expr.js. Identifiers must be inputs, lever factors (conservative or expected, chosen by the case) or earlier derived values; validate fails on unknown identifiers. Money outputs are in $M a year at full run rate. All lever ranges are BENCH / [validate].",
  "currency": "$",
  "unit": "$M a year (full run rate)",
  "inputs": [
    { "id": "electricCustomers", "label": "Electric customers", "default": 3.2, "unit": "M", "min": 0.1, "max": 12, "step": 0.1 },
    { "id": "gasCustomers", "label": "Gas customers", "default": 1.1, "unit": "M", "min": 0, "max": 8, "step": 0.1 },
    { "id": "revenue", "label": "Annual revenue", "default": 11800, "unit": "$M", "min": 500, "max": 60000, "step": 100 },
    { "id": "om", "label": "O&M", "default": 2900, "unit": "$M", "min": 100, "max": 15000, "step": 50 },
    { "id": "saidi", "label": "SAIDI excluding major event days", "default": 128, "unit": "min", "min": 20, "max": 600, "step": 1 },
    { "id": "valuePerCmi", "label": "Value of a customer minute interrupted", "default": 0.35, "unit": "$", "min": 0, "max": 5, "step": 0.05 },
    { "id": "stormOm", "label": "Storm O&M", "default": 260, "unit": "$M/yr", "min": 0, "max": 2000, "step": 10 },
    { "id": "contactsPerCustomer", "label": "Contacts per customer per year", "default": 1.6, "unit": "", "min": 0.2, "max": 5, "step": 0.1 },
    { "id": "costPerContact", "label": "Cost per contact", "default": 6.8, "unit": "$", "min": 1, "max": 30, "step": 0.1 },
    { "id": "truckRolls", "label": "Truck rolls per month", "default": 38000, "unit": "", "min": 1000, "max": 300000, "step": 1000 },
    { "id": "costPerTruckRoll", "label": "Cost per truck roll", "default": 185, "unit": "$", "min": 50, "max": 800, "step": 5 },
    { "id": "vegetationSpend", "label": "Vegetation spend", "default": 310, "unit": "$M/yr", "min": 0, "max": 2000, "step": 10 },
    { "id": "badDebtPct", "label": "Bad debt", "default": 0.9, "unit": "% of revenue", "min": 0, "max": 5, "step": 0.1 },
    { "id": "estimatedBillsPct", "label": "Estimated bills", "default": 2.4, "unit": "%", "min": 0, "max": 20, "step": 0.1 },
    { "id": "costPerEstimatedBill", "label": "Cost to work an estimated bill", "default": 9, "unit": "$", "min": 0, "max": 60, "step": 1 },
    { "id": "forcedOutageRate", "label": "Forced outage rate", "default": 6.5, "unit": "%", "min": 0, "max": 30, "step": 0.1 },
    { "id": "generationGw", "label": "Generation capacity", "default": 9.4, "unit": "GW", "min": 0, "max": 60, "step": 0.1 },
    { "id": "imbalanceCost", "label": "Imbalance cost", "default": 45, "unit": "$M/yr", "min": 0, "max": 500, "step": 1 },
    { "id": "capex", "label": "Annual capex", "default": 4200, "unit": "$M", "min": 0, "max": 40000, "step": 100 },
    { "id": "inspectionMiles", "label": "Line-miles inspected a year", "default": 21000, "unit": "mi", "min": 0, "max": 200000, "step": 500 },
    { "id": "costPerInspectionMile", "label": "Inspection cost per mile", "default": 620, "unit": "$", "min": 0, "max": 5000, "step": 10 },
    { "id": "complianceEffort", "label": "Data, reporting and compliance evidence effort", "default": 38, "unit": "$M/yr", "min": 0, "max": 500, "step": 1 }
  ],
  "levers": [
    { "id": "cmi", "label": "Customer minutes interrupted reduced (value)", "outcome": "reliability", "motion": "operate", "factor": "cmiReduction", "conservative": 0.06, "expected": 0.12,
      "formula": "electricCustomers * 1e6 * saidi * cmiReduction * valuePerCmi / 1e6", "source": "BENCH", "agents": ["UA-GO-02", "UA-GO-01", "UA-GO-03"] },
    { "id": "storm", "label": "Storm O&M avoided", "outcome": "reliability", "motion": "operate", "factor": "stormReduction", "conservative": 0.05, "expected": 0.1,
      "formula": "stormOm * stormReduction", "source": "BENCH", "agents": ["UA-GO-01", "UA-GO-06"] },
    { "id": "contacts", "label": "Contact containment", "outcome": "customer", "motion": "decide-act", "factor": "containment", "conservative": 0.08, "expected": 0.15,
      "formula": "(electricCustomers + gasCustomers) * 1e6 * contactsPerCustomer * containment * costPerContact / 1e6", "source": "BENCH", "agents": ["UA-CC-01", "UA-CC-02", "UA-CC-03"] },
    { "id": "truckRolls", "label": "Truck rolls avoided", "outcome": "affordability", "motion": "operate", "factor": "truckRollReduction", "conservative": 0.04, "expected": 0.08,
      "formula": "truckRolls * 12 * truckRollReduction * costPerTruckRoll / 1e6", "source": "BENCH", "agents": ["UA-GO-06", "UA-DI-06"] },
    { "id": "vegetation", "label": "Vegetation spend optimised", "outcome": "affordability", "motion": "decide-act", "factor": "vegetationSaving", "conservative": 0.03, "expected": 0.06,
      "formula": "vegetationSpend * vegetationSaving", "source": "BENCH", "agents": ["UA-GO-05"] },
    { "id": "badDebt", "label": "Bad debt reduced", "outcome": "affordability", "motion": "decide-act", "factor": "badDebtReduction", "conservative": 0.05, "expected": 0.1,
      "formula": "revenue * badDebtPct / 100 * badDebtReduction", "source": "BENCH", "agents": ["UA-CC-03"] },
    { "id": "estimated", "label": "Estimated bills reduced", "outcome": "customer", "motion": "operate", "factor": "estimatedReduction", "conservative": 0.2, "expected": 0.35,
      "formula": "electricCustomers * 1e6 * 12 * estimatedBillsPct / 100 * estimatedReduction * costPerEstimatedBill / 1e6", "source": "BENCH", "agents": ["UA-DI-07"] },
    { "id": "forced", "label": "Forced outages avoided", "outcome": "reliability", "motion": "operate", "factor": "forcedReduction", "conservative": 0.08, "expected": 0.15,
      "formula": "generationGw * 1000 * 8760 * forcedOutageRate / 100 * forcedReduction * 35 / 1e6", "source": "BENCH", "note": "Replacement energy at $35/MWh (synthetic)", "agents": ["UA-GM-02", "UA-GM-01"] },
    { "id": "imbalance", "label": "Imbalance cost reduced", "outcome": "affordability", "motion": "operate", "factor": "imbalanceReduction", "conservative": 0.1, "expected": 0.2,
      "formula": "imbalanceCost * imbalanceReduction", "source": "BENCH", "agents": ["UA-GM-03", "UA-GM-04"] },
    { "id": "capexDeferred", "label": "Capex deferred by targeted replacement (carrying cost)", "outcome": "growth", "motion": "decide-act", "factor": "capexDeferral", "conservative": 0.005, "expected": 0.01,
      "formula": "capex * capexDeferral * 0.08", "source": "BENCH", "note": "Value is the 8% carrying cost of deferred capital", "agents": ["UA-GO-03", "UA-EE-05"] },
    { "id": "inspection", "label": "Inspection cost per mile", "outcome": "safety", "motion": "operate", "factor": "inspectionSaving", "conservative": 0.1, "expected": 0.2,
      "formula": "inspectionMiles * costPerInspectionMile * inspectionSaving / 1e6", "source": "BENCH", "agents": ["UA-GO-04"] },
    { "id": "evidence", "label": "Data and compliance evidence effort", "outcome": "safety", "motion": "govern", "factor": "evidenceSaving", "conservative": 0.25, "expected": 0.45,
      "formula": "complianceEffort * evidenceSaving", "source": "BENCH", "agents": ["UA-EE-03", "UA-EE-02", "UA-DI-01"] }
  ],
  "derived": [
    { "id": "total", "label": "Total annual value", "formula": "cmi + storm + contacts + truckRolls + vegetation + badDebt + estimated + forced + imbalance + capexDeferred + inspection + evidence" },
    { "id": "omShare", "label": "Share of O&M", "formula": "(storm + contacts + truckRolls + vegetation + estimated + inspection + evidence) / om * 100" },
    { "id": "perCustomer", "label": "Value per customer a year ($)", "formula": "total / (electricCustomers + gasCustomers)" }
  ],
  "ramp": [0.3, 0.7, 1.0],
  "rampLabels": ["Year 1", "Year 2", "Year 3"]
}
